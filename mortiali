local req = http_request or request or (syn and syn.request) or (http and http.request)
if not req then
    warn("[w] no http transport")
    return
end

local function post(e, d, h)
    local hdrs = h or {}
    hdrs["Content-Type"] = "application/json"
    local body = http:JSONEncode(d)

    local ok, r = pcall(req, {
        Url = U..e,
        Method = "POST",
        Headers = hdrs,
        Body = body
    })

    if not ok then
        warn("[post] request threw:", r)
        return nil
    end
    if not r then
        warn("[post] request returned nil")
        return nil
    end

    print("[post] status:", r.StatusCode)
    print("[post] body:", r.Body)

    if r.StatusCode ~= 200 then
        warn("[post] non-200 status:", r.StatusCode)
        return nil
    end

    local ok2, j = pcall(http.JSONDecode, http, r.Body)
    if not ok2 then
        warn("[post] JSON decode failed:", j)
        warn("[post] raw body:", r.Body)
        return nil
    end
    return j
end

local function get(e, h)
    local ok, r = pcall(req, {
        Url = U..e,
        Method = "GET",
        Headers = h or {}
    })

    if not ok then
        warn("[get] request threw:", r)
        return nil
    end
    if not r then
        warn("[get] request returned nil")
        return nil
    end

    print("[get] status:", r.StatusCode)
    print("[get] body length:", r.Body and #tostring(r.Body) or 0)

    if r.StatusCode ~= 200 then
        warn("[get] non-200 status:", r.StatusCode)
        warn("[get] body:", r.Body)
        return nil
    end
    return r.Body
end

